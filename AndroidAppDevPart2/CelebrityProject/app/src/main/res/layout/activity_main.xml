<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Работа со слоем Domain (MVVM)"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewCelebrity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minLines="2"
            android:text="Данные не загружены"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonGetCelebrity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Отобразить сохраненных" />

        <EditText
            android:id="@+id/editTextCelebrity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Имя знаменитости" />

        <Button
            android:id="@+id/buttonSaveCelebrity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Сохранить в БД (Use Case)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="24dp"
            android:background="#DDDDDD" />

        <!-- БЛОК КОНТРОЛЬНОГО ЗАДАНИЯ: MediatorLiveData -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Контрольное задание: MediatorLiveData"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewMediator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EFEFEF"
            android:padding="12dp"
            android:text="Ожидание загрузки объединенных данных..."
            android:textColor="#0D47A1"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonFetchCombined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Объединить данные (Сеть + БД)" />

    </LinearLayout>
</ScrollView>