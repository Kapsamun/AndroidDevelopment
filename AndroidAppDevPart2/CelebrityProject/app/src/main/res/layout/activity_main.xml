<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:descendantFocusability="beforeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Работа со слоем Domain (MVVM)"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonGetCelebrity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Отобразить сохраненных" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCelebrities"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <EditText
            android:id="@+id/editTextCelebrity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Имя знаменитости" />

        <Button
            android:id="@+id/buttonSaveCelebrity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Сохранить в БД (Use Case)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="20dp"
            android:background="#DDDDDD" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Контрольное задание: MediatorLiveData"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonFetchCombined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Объединить данные (Сеть + БД)" />

    </LinearLayout>
</ScrollView>