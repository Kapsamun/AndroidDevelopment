<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".presantation.MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Знаменитости"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- RecyclerView — основной список -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCelebrities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- Старый блок (можно оставить для сохранения избранного) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginVertical="8dp" />

    <TextView
        android:id="@+id/textViewCelebrity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minLines="1"
        android:text="Избранное не загружено"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/editTextCelebrity"
            android:layout_width="314dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Имя знаменитости"
            android:inputType="textPersonName" />

        <Button
            android:id="@+id/buttonSaveCelebrity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сохранить" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonGetCelebrity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Показать избранных" />

    <TextView
        android:id="@+id/textViewMediator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#EFEFEF"
        android:padding="8dp"
        android:text="MediatorLiveData..."
        android:textSize="13sp"
        android:textColor="#0D47A1" />

    <Button
        android:id="@+id/buttonFetchCombined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Объединить (Сеть + БД)" />

</LinearLayout>