<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/buttonGetCelebrity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Отобразить сохранённых" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCelebrities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/editTextCelebrity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Имя знаменитости" />

    <Button
        android:id="@+id/buttonSaveCelebrity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Сохранить в БД" />

    <Button
        android:id="@+id/buttonFetchCombined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Объединить данные (Сеть + БД)" />
</LinearLayout>