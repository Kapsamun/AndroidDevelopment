<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/celebrityListFragment">

    <!-- Список знаменитостей -->
    <fragment
        android:id="@+id/celebrityListFragment"
        android:name="com.mirea.kapsamunelenanikolaevna.celebritybase.presantation.CelebrityListFragment"
        android:label="Список"
        tools:layout="@layout/fragment_celebrity_list">
        <action
            android:id="@+id/action_list_to_details"
            app:destination="@id/celebrityDetailsFragment" />
    </fragment>

    <!-- Детали знаменитости -->
    <fragment
        android:id="@+id/celebrityDetailsFragment"
        android:name="com.mirea.kapsamunelenanikolaevna.celebritybase.presantation.CelebrityDetailsFragment"
        android:label="Детали"
        tools:layout="@layout/fragment_celebrity_details">

        <argument
            android:name="celebrityId"
            app:argType="integer" />

        <argument
            android:name="celebrityName"
            app:argType="string" />
        <argument
            android:name="celebrityPhoto"
            app:argType="string" />
        <argument
            android:name="celebrityBio"
            app:argType="string" />
    </fragment>

    <!-- Избранное -->
    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.mirea.kapsamunelenanikolaevna.celebritybase.presantation.FavoritesFragment"
        android:label="Избранное"
        tools:layout="@layout/fragment_favorites" />

    <!-- Распознавание -->
    <fragment
        android:id="@+id/recognizeFragment"
        android:name="com.mirea.kapsamunelenanikolaevna.celebritybase.presantation.RecognizeFragment"
        android:label="Распознавание"
        tools:layout="@layout/fragment_recognize" />

</navigation>